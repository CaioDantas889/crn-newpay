# Ambiente do CRM NewPay em produção.
# Copie para .env (ou configure as mesmas variáveis no painel do host).
# Em desenvolvimento nada disso é obrigatório: npm run dev usa os padrões.

# Liga o modo de produção: exige segredo, desliga o banco de demonstração e
# faz o próprio Express servir o front (web/dist).
NODE_ENV=production

# Porta da API. (É API_PORT, e não PORT, para não colidir com o dev server.)
API_PORT=4000

# Assinatura dos tokens de sessão. SEM ISSO O SERVIDOR NÃO SOBE.
# Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEWPAY_SECRET=troque-por-um-segredo-com-no-minimo-24-caracteres

# Quanto tempo a sessão dura antes de pedir login de novo.
# Padrão: 720 (30 dias) — o vendedor não fica redigitando senha em campo.
# Inativar a pessoa em Equipe corta o acesso na hora, sem esperar isso vencer.
NEWPAY_HORAS_SESSAO=720

# Disco persistente: banco (db.json), anexos de visita e backups.
# Em host com volume montado, aponte para o volume (ex.: /data).
# Se isso ficar no disco efêmero do container, cada deploy apaga tudo.
NEWPAY_DATA_DIR=/data

# Backups automáticos do banco (rotativos, dentro de NEWPAY_DATA_DIR/backups).
NEWPAY_BACKUP_MAX=20
NEWPAY_BACKUP_INTERVALO_MIN=30

# Primeiro acesso, usado só quando o banco ainda não existe.
# Esse gestor nasce com troca de senha obrigatória e cadastra o resto da equipe
# pela própria tela de Equipe.
NEWPAY_ADMIN_NOME=Seu Nome
NEWPAY_ADMIN_EMAIL=voce@empresa.com.br
NEWPAY_ADMIN_SENHA=uma-senha-forte-de-primeiro-acesso
NEWPAY_ADMIN_CIDADE=Iguatu

# Nome da rua na batida de ponto. O servidor converte a coordenada usando o
# Nominatim (OpenStreetMap): sem chave e sem custo, mas é a única chamada a
# serviço externo do CRM. Coloque false para guardar só latitude e longitude.
NEWPAY_GEOCODIFICAR=true
# Contato que identifica o CRM na consulta (exigência do Nominatim)
NEWPAY_CONTATO=crm@newpay.com.br

# Lead remoto: o CNPJ é consultado na Receita pela BrasilAPI (gratuita, sem
# chave) — razão social, endereço e situação; CNPJ inativo ou inexistente é
# bloqueado. Em servidor sem saída para a internet, false confere só os
# dígitos verificadores.
NEWPAY_CONSULTAR_CNPJ=true

# Fuso da operação. A meta é "30 leads por dia" e os lembretes têm hora
# marcada (8h, 11h, 15h, 18h e o resumo das 19h): tudo segue o relógio do
# servidor. Servidor em UTC viraria o dia às 21h de Iguatu.
TZ=America/Fortaleza

# --- Só se o front for hospedado separado da API -------------------------
# Por padrão o Express serve web/dist e não existe origem externa nenhuma.
# Se o front ficar em outro domínio, liste as origens liberadas no CORS:
# NEWPAY_ORIGINS=https://crm.suaempresa.com.br
# E desligue o serviço de arquivos estáticos:
# NEWPAY_SERVIR_FRONT=false
