{
  "name": "newpay-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CRM NewPay - Modulo Calendario e Central de Comando do Vendedor Externo",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix web install",
    "seed": "npm --prefix server run seed",
    "seed:vazio": "npm --prefix server run seed:vazio --",
    "criar:admin": "npm --prefix server run criar:admin --",
    "importar:clientes": "npm --prefix server run importar:clientes --",
    "smoke": "npm --prefix server run smoke",
    "teste:pwa": "npm --prefix web run teste:pwa",
    "limpar:demo": "npm --prefix server run limpar:demo --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
